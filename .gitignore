# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size
[Mm]emory[Cc]aptures/

# Asset meta data should only be ignored when the corresponding resource is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# [Aa]ssets/[Aa]sset[Ss]tore[Tt]ools*/

# Autogenerated Jetbrains Rider solution file
*.sln

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/

# OS cruft
.DS_Store
Thumbs.db

# Claude / project tooling
.playwright-mcp/
ui_audits/

# slnx (Unity auto-generated)
*.slnx

# Test screenshots (Claude/MCP captures)
/Assets/Screenshots/

# --- Dev scratch (kept local, never committed) ---
# Root-level debug logs, screenshots, python pipeline scripts
/*.log
/*.png
/*.py
# Heavy reference / scratch dirs
/_backup/
/_ref_tmp/
/Assets/_Recovery/
/UIReferences/
/figma_assets/
/figma_exports/
/figma_screens/
/figma-exports/
/docs/agents/
# Stray Flutter app copy (lives in its own repo)
/kinex_app/
# ML pose models (large, regenerated by pipeline)
/*.task
/*.pt
# Project tooling / agent config
/.claude/
/.agents/
/.vscode/
/skills-lock.json
/game-brief.md
/project-analysis.md

# Local scratch / debug artefacts (not source)
/_posestudio/
/_figma_info/
/dev/
/Assets/Screenshots.meta
